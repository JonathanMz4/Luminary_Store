# ==========================================
# LUMINARY STORE — ENTERPRISE API CONFIG
# ==========================================

# Configuração do Servidor Express
PORT=5000
NODE_ENV=production
FRONTEND_URL=https://luminarystore.netlify.app

# Configuração do Banco de Dados MySQL em Nuvem (Ex: Aiven, PlanetScale, AWS RDS, DigitalOcean)
DB_HOST=seu-servidor-mysql.cloud.com
DB_USER=root_pro
DB_PASS=SuaSenhaSegura123!
DB_NAME=luminary_store_prod
DB_PORT=3306

# Segurança & Criptografia (JWT)
# Gere uma string aleatória forte, ex: openssl rand -base64 32
JWT_SECRET=luminary_secret_key_enterprise_2026_super_secure_hash
JWT_EXPIRES_IN=7d
